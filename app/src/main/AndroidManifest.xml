<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 3.0 全封闭：无 INTERNET 权限，完全离线运行 -->
    <!-- Android 11+ 包可见性：允许“从应用列表选择”读取全部已安装应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Shizuku：以 ADB/root 身份调用系统接口（API V23 动态授权） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.QQReplyApp">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:label="主题" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.catpaw.kittytalk.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku Provider：Shizuku 管理器通过它识别并授权本应用 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".AutomationBridge"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 系统快捷设置面板的服务开关磁贴 -->
        <service
            android:name=".QuickToggleService"
            android:exported="true"
            android:icon="@drawable/ic_quick_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 磁贴长按弹出的快捷开关面板：系统长按磁贴时按 QS_TILE_PREFERENCES 打开本页。
             独立任务 + 透明浮窗 + 不进最近任务，视觉上只弹对话框，不会把应用主界面带到前台。 -->
        <activity
            android:name=".TilePanelActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@style/Theme.TilePanel">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 常驻保活前台服务：随无障碍服务运行，防止进程被系统回收 -->
        <service
            android:name=".LifelineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep accessibility service alive for text replacement" />
        </service>

    </application>
</manifest>
