<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 自带配色预设：覆盖 Primary 系列颜色槽；
         颜色资源 pal_*_* 自动按浅色/夜间切换，因此无需重复 style -->
    <style name="Theme.QQReplyApp.Purple" parent="Theme.QQReplyApp">
        <item name="colorPrimary">@color/pal_purple_primary</item>
        <item name="colorOnPrimary">@color/pal_purple_onPrimary</item>
        <item name="colorPrimaryContainer">@color/pal_purple_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/pal_purple_onPrimaryContainer</item>
        <item name="android:colorBackground">@color/pal_purple_background</item>
        <item name="colorSurface">@color/pal_purple_background</item>
        <item name="colorOnSurface">@color/pal_purple_onSurface</item>
    </style>

