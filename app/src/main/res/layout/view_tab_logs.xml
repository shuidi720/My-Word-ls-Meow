<?xml version="1.0" encoding="utf-8"?>
<!-- 日志页：日志铺满整个界面，操作收进右下角竖排悬浮小按钮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="无障碍服务日志"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:id="@+id/logHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:text="长按可选择复制部分文字；悬浮按钮一键复制全部"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/debugLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="72dp"
                android:fontFamily="monospace"
                android:text="（暂无日志）"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textIsSelectable="true"
                android:typeface="monospace" />

        </ScrollView>

    </LinearLayout>

    <!-- 右下角竖排悬浮小按钮：用 ImageButton 保证 src 图标精确居中 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageButton
            android:id="@+id/jumpTopButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_float_circle"
            android:contentDescription="回到顶部"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_up"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/jumpBottomButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_float_circle"
            android:contentDescription="回到底部"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_down"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/copyLogButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_float_circle"
            android:contentDescription="复制全部日志"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_copy"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/refreshLogButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_float_circle"
            android:contentDescription="刷新"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/clearLogButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_float_circle_delete"
            android:contentDescription="清空日志"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorOnErrorContainer" />

    </LinearLayout>

</FrameLayout>